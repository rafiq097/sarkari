          },
          {
            "name": "General Awareness",
            "marks": 50,
            "questions": 25,
            "duration": "15 min",
            "negative": "0.50"
          }
        ],
        "notes": "100 questions, 200 marks, 60 minutes. Screening."
      },
      {
        "name": "Tier II (computer-based, same day)",
        "type": "objective",
        "countsInMerit": true,
        "papers": [
          {
            "name": "Section I: Mathematical Abilities (30 Q) + Reasoning (30 Q)",
            "marks": 180,
            "questions": 60,
            "duration": "1 hour",
            "negative": "1 mark per wrong answer"
          },
          {
            "name": "Section II: English (40 Q) + General Awareness (20 Q)",
            "marks": 180,
            "questions": 60,
            "duration": "1 hour",
            "negative": "1 mark"
          },
          {
            "name": "Section III: Computer Knowledge Test",
            "marks": 45,
            "questions": 15,
            "duration": "15 min",
            "qualifying": true,
            "negative": "1 mark"
          },
          {
            "name": "Section IV: Skill / Typing Test",
            "duration": "15 min",
            "qualifying": true,
            "notes": "DEO (specified ministries): 15,000 key depressions per hour. Other DEO: 8,000 per hour. LDC/JSA: typing 35 wpm English or 30 wpm Hindi."
          }
        ],
        "notes": "Sessions I (2 hours 15 minutes) and II on the same day. Every section must be qualified."
      },
      {
        "name": "Document verification",
        "type": "document",
        "countsInMerit": false
      }
